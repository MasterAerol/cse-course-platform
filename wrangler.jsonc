{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cse-course-platform",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-07-27",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "REGISTRATION_MODE": "closed",
    "GOOGLE_CLIENT_ID": "247375246816-10qnqrcf5c2sarc6gvbpdbtdocbs5p1o.apps.googleusercontent.com"
  },
  "ratelimits": [
    { "name": "LOGIN_IP_RATE_LIMITER", "namespace_id": "31001", "simple": { "limit": 10, "period": 60 } },
    { "name": "LOGIN_ACCOUNT_RATE_LIMITER", "namespace_id": "31002", "simple": { "limit": 5, "period": 60 } },
    { "name": "REGISTRATION_RATE_LIMITER", "namespace_id": "31003", "simple": { "limit": 3, "period": 60 } },
    { "name": "ATTEMPT_RATE_LIMITER", "namespace_id": "31004", "simple": { "limit": 10, "period": 60 } },
    { "name": "AUTOSAVE_RATE_LIMITER", "namespace_id": "31005", "simple": { "limit": 180, "period": 60 } },
    { "name": "ADMIN_RATE_LIMITER", "namespace_id": "31006", "simple": { "limit": 300, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cse-course-platform",
      "database_id": "614f781f-bdb5-4879-95bf-b26c7b8c6d12",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PAYMENT_RECEIPTS",
      "bucket_name": "pasawise-payment-receipts"
    }
  ]
}
