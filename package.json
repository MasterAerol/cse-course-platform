{
  "name": "cse-course-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/verify-worker-route-bundle.mjs",
    "deploy": "npm run build && wrangler deploy",
    "release:safe": "node scripts/safe-release.mjs",
    "content:release": "node scripts/content-release.mjs",
    "release:teaching": "node scripts/safe-teaching-release.mjs",
    "preview": "npm run build && vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.ui-test.json --noEmit && tsc -p tsconfig.node.json --noEmit && npm run cf-typegen:check",
    "lint": "eslint .",
    "test": "vitest run",
    "cf-typegen": "node scripts/worker-typegen.mjs",
    "cf-typegen:check": "node scripts/worker-typegen.mjs --check",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "hono": "^4.11.1",
    "jose": "^6.2.5",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router": "^8.3.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.16",
    "wrangler": "^4.125.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
