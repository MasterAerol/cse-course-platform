{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": [
      "node",
      "vitest/globals",
      "@cloudflare/vitest-pool-workers/types",
      "./src/worker/worker-configuration.d.ts"
    ],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.smart-recovery-constraints.config.ts",
    "vitest.smart-recovery-migration.config.ts",
    "eslint.config.js",
    "tests",
    "src/worker"
  ],
  "exclude": ["tests/registration-policy-ui.test.tsx"]
}
